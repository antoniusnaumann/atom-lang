+ExitCode (
    Success
    Failure
)

+exit(status ExitCode) {
    cstdlib::exit(match(status) { Success { 0 }, Failure { 1 } })
}

+assert(condition Bool) {
    match(condition) {
        True { }
        False { error("Assertion failed!") }
    }
}

+assert(condition Bool, msg String) {
    match(condition) {
        True { }
        False { error("Assertion failed: " ++ msg) }
    }   
}

/// Prints the error message and quits
+error(msg String) {
    // TODO: Fix print to support LogLevel parameter
    // print(msg, Fatal)
    exit(Failure)
}
