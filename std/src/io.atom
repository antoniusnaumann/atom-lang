+LogLevel (
    Trace
    Debug
    Info
    Warn
    Error
    Fatal
)

// TODO: Get the default for this from the debug build, debug builds should specify Debug, production builds Info
// TODO: Explain overridable functions in README.md
+log_level() LogLevel { Info }

/// Print a string to stdout
+print(msg String, level LogLevel = Info, delimiter Rune = '\n') {
    match(level >= log_level()) {
        True { 
            cstdlib::printf(msg)
            cstdlib::printf(&delimiter)
            ()
        }
        False { () }
    }
}

/// Print an integer to stdout
+print(msg Int, level LogLevel = Info, delimiter Rune = '\n') {
    match(level >= log_level()) {
        True {
            cstdlib::printf("%lld", msg)
            cstdlib::printf(&delimiter)
            ()
        }
        False { () }
    }
}

/// Print a float to stdout
+print(msg Float, level LogLevel = Info, delimiter Rune = '\n') {
    match(level >= log_level()) {
        True {
            cstdlib::printf("%g", msg)
            cstdlib::printf(&delimiter)
            ()
        }
        False { () }
    }
}

/// Print a boolean to stdout
+print(msg Bool, level LogLevel = Info, delimiter Rune = '\n') {
    match(level >= log_level()) {
        True {
            match(msg) {
                True { cstdlib::printf("true") }
                False { cstdlib::printf("false") }
            }
            cstdlib::printf(&delimiter)
            ()
        }
        False { () }
    }
}

