main() {
    print("Testing Int* ++ Int*")
    first: Int* = (1, 2, 3)
    second: Int* = (4, 42, 6)
    combined := first ++ second 
    combined(2).print()  // Expected: 3
    combined(4).print()  // Expected: 42

    print("Testing Int* ++ Int")
    first: Int* = (1, 2, 3)
    combined := first ++ 42
    combined(3).print()  // Expected: 42

    print("Testing tuple ++ tuple")
    first := (1, 2, 3)
    second := (4, 5)
    combined := first ++ second
    combined(2).print()  // Expected: 3
    combined(4).print()  // Expected: 5
}
