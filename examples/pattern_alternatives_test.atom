Token(
    LParen,
    RParen,
    LBrace,
    RBrace,
    Plus,
    Minus,
    Star,
    Slash
)

token_type(tok Token) Int {
    match(tok) {
        LParen | RParen | LBrace | RBrace {
            1
        }
        Plus | Minus {
            2
        }
        Star | Slash {
            3
        }
    }
}

main() Int {
    t1 := token_type(LParen)   // Should be 1
    t2 := token_type(RBrace)    // Should be 1
    t3 := token_type(Plus)      // Should be 2
    t4 := token_type(Minus)     // Should be 2
    t5 := token_type(Star)      // Should be 3
    t6 := token_type(Slash)     // Should be 3
    t1 + t2 + t3 + t4 + t5 + t6 // Should be 1+1+2+2+3+3 = 12
}
