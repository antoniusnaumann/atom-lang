/// A simple math utility library demonstrating deps/ usage

/// Add two integers
+add(a Int, b Int) Int {
    a + b
}

/// Multiply two integers
+multiply(a Int, b Int) Int {
    a * b
}

/// Calculate factorial (iterative to avoid recursion issues)
+factorial(n Int) Int {
    result := 1
    i := 2
    loop(i <= n) {
        result = result * i
        i = i + 1
    }
    result
}
