+Binary(
    op BinOp
    left Expression
    right Expression
    span Span
)

+Unary(
    op UnOp
    expr Expression
    span Span
)

+BinOp(
    // Arithmetic
    Add
    Sub
    Mul
    Div
    Mod

    // Comparison
    Eq  // ==
    Ne  // !=
    Lt  // <
    Le  // <=
    Gt  // >
    Ge  // >=

    // Logical & Bitwise
    And  // &
    Or   // |
    Xor  // ^
    ShortCircAnd  // &&
    ShortCircOr   // ||
    LShift        // <<
    RShift        // >>

    // Collection
    Concat      // ++
    
    // Assignment
    Assign        // =
    AddAssign     // +=
    SubAssign     // -=
    MulAssign     // *=
    DivAssign     // /=
    ModAssign     // %=
    
    AndAssign     // &=
    OrAssign      // |=
    XorAssign     // ^=
    LShiftAssign  // <<=
    RShiftAssign  // >>=
    
    ConcatAssign  // ++=
)

+UnOp(
    Neg
    Not  // !, works as bitwise not and logical not
)
