+TopLevel(
    Import(_)
    Struct(_)
    Enum(_)
    Function(_)
    TestBlock(_)
    /// Statement (only allowed in .test.atom files)
    Statement(_)
)

+Import(
    namespace Ident
    items ImportItems
    span Span
)

+ImportItems(
    All
    Named(Ident*)
)

+TestBlock(
    name Option(String)
    body Block
    span Span
)

+Block(
    statements Statement*
    span Span
)

+Visibility(
    Public   // +
    Private  // -
    Internal // (default)
)

+Ident(
    name String
    span Span
)

+Variable(
    visibility Visibility
    names Ident*
    types TypeItem*
    init Option(Expression)
    span Span
)

+Statement(
    Variable(_)
    Expression(_)
)
