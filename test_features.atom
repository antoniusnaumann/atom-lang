// Test file for implemented features

+test_arithmetic() Int {
    a := 10
    b := 5
    c := a + b   // 15
    d := c * 2   // 30
    e := d - 10  // 20
    e / 4        // 5
}

+test_mutable_vars() Int {
    x := 1
    x = 2
    x = x + 3
    x  // 5
}

+test_bool_enum() Int {
    b := False
    match(b) {
        True { 1 }
        False { 42 }
    }
}

+test_match_with_mutation() Int {
    found := False
    item := 7
    match(item == 7) {
        True { found = True }
        False { }
    }
    match(found) {
        True { 100 }
        False { 0 }
    }
}

+test_function_calls() Int {
    test_arithmetic() + test_bool_enum()  // 5 + 42 = 47
}

+main() Int {
    test_function_calls()  // Should return 47
}
